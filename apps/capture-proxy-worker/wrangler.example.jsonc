{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "YOUR_CAPTURE_PROXY_WORKER",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vpc_networks": [
    {
      "binding": "CAPTURE_VPC",
      "tunnel_id": "REPLACE_WITH_NAMED_TUNNEL_ID",
      "remote": true
    }
  ]
}
